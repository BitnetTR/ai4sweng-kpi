{
  "kios": ["KIO1", "KIO2", "KIO3", "KIO4", "KIO5", "KIO6", "KIO7", "KIO8", "KIO9", "KIO10", "KIO11", "KIO12", "KIO13"],
  "kpis": [
    {
      "id": "1.1",
      "name": "Code generation speed",
      "attr": "code_generation_speed",
      "definition": "Average time from the start of the prompt/template to the first successful build of a 300-500 LOC feature.",
      "unit": "% of baseline duration",
      "baseline": "100% (~100-120 min)",
      "target": "≤ 70% (~30% reduction)",
      "kios": ["KIO1", "KIO2", "KIO3", "KIO4", "KIO7"],
      "otel": [
        {
          "name": "kio.codegen.duration_minutes",
          "instrument": "Histogram",
          "unit": "min",
          "required_attributes": ["source", "llm", "task_type"]
        }
      ]
    },
    {
      "id": "1.2",
      "name": "Issue resolution speed",
      "attr": "issue_resolution_speed",
      "definition": "Time from defect detection (CI/CD or QA) to an approved fix and successful merge.",
      "unit": "% of baseline duration",
      "baseline": "100% (~1.0-1.5 business days)",
      "target": "≤ 70% (~0.7 days)",
      "kios": ["KIO1", "KIO2", "KIO3", "KIO4", "KIO7"],
      "otel": [
        {
          "name": "kio.issue.resolution_hours",
          "instrument": "Histogram",
          "unit": "h",
          "required_attributes": ["source", "llm", "task_type"]
        }
      ]
    },
    {
      "id": "2.1",
      "name": "Lifecycle energy reduction",
      "attr": "lifecycle_energy_reduction",
      "definition": "Total energy consumed across a feature's lifecycle (training + inference + build/test/deploy).",
      "unit": "% of baseline energy",
      "baseline": "100%",
      "target": "≤ 85% (≥15% reduction)",
      "kios": ["KIO1", "KIO7", "KIO8", "KIO10"],
      "otel": [
        {
          "name": "kio.lifecycle_energy.pct_of_baseline",
          "instrument": "Histogram",
          "unit": "%",
          "required_attributes": ["source", "llm", "task_type"]
        }
      ]
    },
    {
      "id": "2.2",
      "name": "Deployment energy efficiency",
      "attr": "deployment_energy_efficiency",
      "definition": "Efficiency during inference/code generation: tokens·s⁻¹·W⁻¹.",
      "unit": "tokens/s/W",
      "baseline": "100% (unoptimized)",
      "target": "≥15% improvement",
      "kios": ["KIO1", "KIO7", "KIO8", "KIO10"],
      "otel": [
        {
          "name": "kio.deploy_energy.tokens_per_s_per_w",
          "instrument": "Histogram",
          "unit": "1",
          "required_attributes": ["source", "llm", "task_type"]
        }
      ]
    },
    {
      "id": "3.1",
      "name": "Code quality improvement",
      "attr": "code_quality_improvement",
      "definition": "Composite score of readability + maintainability + standards compliance (Sonar-like).",
      "unit": "% of baseline score",
      "baseline": "100%",
      "target": "≤ 70% (≥30% improvement)",
      "kios": ["KIO1", "KIO4", "KIO7", "KIO9"],
      "otel": [
        {
          "name": "kio.code_quality.score_pct",
          "instrument": "Histogram",
          "unit": "%",
          "required_attributes": ["source", "llm", "task_type"]
        }
      ]
    },
    {
      "id": "3.2",
      "name": "Review score increase",
      "attr": "review_score_increase",
      "definition": "Peer-review score difference between AI-assisted and traditional code.",
      "unit": "% of baseline score",
      "baseline": "100% (~3.5/5)",
      "target": "≤ 120% (~4.2/5)",
      "kios": ["KIO1", "KIO4", "KIO7", "KIO9"],
      "otel": [
        {
          "name": "kio.review.score",
          "instrument": "Histogram",
          "unit": "1",
          "required_attributes": ["source", "llm", "task_type"]
        }
      ]
    },
    {
      "id": "4.1",
      "name": "Developer productivity",
      "attr": "developer_productivity",
      "definition": "Number of tasks/features completed per developer per sprint (normalized to working hours).",
      "unit": "% of baseline productivity",
      "baseline": "100% (~1 feature/day)",
      "target": "≤ 120% (~1.20 features/day)",
      "kios": ["KIO1", "KIO7", "KIO13"],
      "otel": [
        {
          "name": "kio.dev_productivity.features_per_day",
          "instrument": "Histogram",
          "unit": "1",
          "required_attributes": ["source", "llm", "task_type"]
        }
      ]
    },
    {
      "id": "5.1",
      "name": "Time-to-Market (Pilot Feature Release)",
      "attr": "time_to_market_pilot_feature_release",
      "definition": "Time from feature design to a successful deployment to the test environment.",
      "unit": "% of baseline duration",
      "baseline": "100% (~5-7 days)",
      "target": "≤ 70% (~3-5 days)",
      "kios": ["KIO1", "KIO7", "KIO11"],
      "otel": [
        {
          "name": "kio.time_to_market.days",
          "instrument": "Histogram",
          "unit": "d",
          "required_attributes": ["source", "llm", "task_type"]
        }
      ]
    },
    {
      "id": "6.1",
      "name": "Bug-fix time",
      "attr": "bug_fix_time",
      "definition": "Average time from bug report to a successful merge into the main branch.",
      "unit": "% of baseline duration",
      "baseline": "100% (~8-12 hours)",
      "target": "≤ 80% (~20% reduction)",
      "kios": ["KIO1", "KIO2", "KIO7", "KIO11"],
      "otel": [
        {
          "name": "kio.bugfix.duration_hours",
          "instrument": "Histogram",
          "unit": "h",
          "required_attributes": ["source", "llm", "task_type"]
        }
      ]
    },
    {
      "id": "6.2",
      "name": "Customer-reported issues",
      "attr": "customer_reported_issues",
      "definition": "Average number of functional/usability issues reported by test users per pilot feature.",
      "unit": "% of baseline rate",
      "baseline": "100% (~5 issues/feature)",
      "target": "≤ 80% (~4 issues/feature)",
      "kios": ["KIO1", "KIO2", "KIO7", "KIO11"],
      "otel": [
        {
          "name": "kio.issue.customer_reported_count",
          "instrument": "Counter",
          "unit": "1",
          "required_attributes": ["source", "llm", "task_type"]
        }
      ]
    },
    {
      "id": "7.1",
      "name": "Annual cost saving",
      "attr": "annual_cost_saving",
      "definition": "Total annual cost reduction including developer time, test effort, and rework hours (per FTE).",
      "unit": "% of baseline cost",
      "baseline": "100% (~€100,000/year)",
      "target": "≤ 85% (~€85,000/year)",
      "kios": ["KIO1", "KIO7", "KIO8", "KIO10"],
      "otel": [
        {
          "name": "kio.cost_saving.pct",
          "instrument": "Histogram",
          "unit": "%",
          "required_attributes": ["source", "llm", "task_type"]
        }
      ]
    },
    {
      "id": "8.1",
      "name": "Adoption rate",
      "attr": "adoption_rate",
      "definition": "Percentage of active developers/teams regularly using AI4SWEng features.",
      "unit": "% of users",
      "baseline": "0%",
      "target": "≥50% (within 2 pilot sprints)",
      "kios": ["KIO1", "KIO13"],
      "otel": [
        {
          "name": "kio.adoption.active_user_pct",
          "instrument": "Histogram",
          "unit": "%",
          "required_attributes": ["source", "llm", "task_type"]
        }
      ]
    },
    {
      "id": "8.2",
      "name": "Active usage & satisfaction",
      "attr": "active_usage_satisfaction",
      "definition": "Active usage percentage + user satisfaction score (MOS 1-5). Realized in kio_simulator.py as two separate real metrics -- select which one to record with the 'usage_pct' or 'mos_score' otel_key.",
      "unit": "% / MOS",
      "baseline": "Usage: 0%, MOS: ~3.0/5",
      "target": "Usage ≥60%, MOS ≥ 4.0/5",
      "kios": ["KIO1", "KIO13"],
      "otel": [
        {
          "key": "usage_pct",
          "name": "kio.adoption.usage_pct",
          "instrument": "Histogram",
          "unit": "%",
          "required_attributes": ["source", "llm", "task_type"]
        },
        {
          "key": "mos_score",
          "name": "kio.adoption.mos_score",
          "instrument": "Histogram",
          "unit": "1",
          "required_attributes": ["source", "llm", "task_type"]
        }
      ]
    },
    {
      "id": "8.3",
      "name": "Cross-Architecture Build Success Rate",
      "attr": "cross_architecture_build_success_rate",
      "definition": "Automated configuration build/run succeeding on at least one heterogeneous target architecture (FPGA/ARM/RISC-V).",
      "unit": "Count",
      "baseline": "0",
      "target": "≥ 1 validated target",
      "kios": ["KIO1", "KIO8"],
      "otel": [
        {
          "name": "kio.cross_arch_build.success_count",
          "instrument": "Counter",
          "unit": "1",
          "required_attributes": ["source", "llm", "task_type"]
        }
      ]
    },
    {
      "id": "9.1",
      "name": "Refactoring reduction",
      "attr": "refactoring_reduction",
      "definition": "Reduction in post-review/deploy refactoring effort (hours/commit).",
      "unit": "% reduction",
      "baseline": "100% (~2-3 hours/feature)",
      "target": "≤ 80% (~25% reduction)",
      "kios": ["KIO1", "KIO7", "KIO9"],
      "otel": [
        {
          "name": "kio.refactoring.hours_per_feature",
          "instrument": "Histogram",
          "unit": "h",
          "required_attributes": ["source", "llm", "task_type"]
        }
      ]
    },
    {
      "id": "9.2",
      "name": "Technical debt reduction",
      "attr": "technical_debt_reduction",
      "definition": "Reduction in estimated effort required to fix code smell/complexity/maintainability violations.",
      "unit": "% of baseline debt",
      "baseline": "100% (~1.0-1.2 hours/100 LOC)",
      "target": "≤ 80% (~20% reduction)",
      "kios": ["KIO1", "KIO7", "KIO9"],
      "otel": [
        {
          "name": "kio.tech_debt.hours_per_100loc",
          "instrument": "Histogram",
          "unit": "h",
          "required_attributes": ["source", "llm", "task_type"]
        }
      ]
    }
  ]
}
